# Optional. compose.yaml already sets working defaults for the local demo.

# Backend paths inside the container
FOOTBALL_PROCESSED_ROOT=/app/data/processed
FOOTBALL_ARTIFACTS_ROOT=/app/artifacts

# Extra CORS origins, comma-separated (Vite origins are always included)
FOOTBALL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend: leave empty so the browser uses same-origin /api and /health,
# which the Vite preview server proxies to the backend.
VITE_API_BASE=
API_PROXY_TARGET=http://backend:8000
